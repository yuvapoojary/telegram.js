{
  "name": "telegramxjs",
  "version": "2.0.0",
  "description": "A powerful, fully-typed Node.js library for the Telegram Bot API, inspired by discord.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "homepage": "https://telegram.js.org",
  "repository": { "type": "git", "url": "git+https://github.com/yuvapoojary/telegram.js.git", "directory": "packages/telegram.js" },
  "bugs": { "url": "https://github.com/yuvapoojary/telegram.js/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "keywords": ["telegram", "telegramx.js", "telegram-bot", "bot", "api", "client", "typescript"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "docs": "api-extractor run --local",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@telegramxjs/builders": "^2.0.0",
    "@telegramxjs/rest": "^2.0.0",
    "@telegramxjs/types": "^2.0.0"
  }
}
