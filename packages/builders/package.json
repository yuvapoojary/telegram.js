{
  "name": "@telegramxjs/builders",
  "version": "2.0.0",
  "description": "Fluent builders for Telegram Bot API keyboards and markup.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "license": "Apache-2.0",
  "homepage": "https://telegram.js.org",
  "repository": { "type": "git", "url": "git+https://github.com/yuvapoojary/telegram.js.git", "directory": "packages/builders" },
  "bugs": { "url": "https://github.com/yuvapoojary/telegram.js/issues" },
  "publishConfig": { "access": "public", "provenance": true },
  "keywords": ["telegram", "telegram-bot", "bot", "api", "keyboard", "builders", "typescript"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "docs": "api-extractor run --local"
  },
  "dependencies": {
    "@telegramxjs/types": "^2.0.0"
  }
}
